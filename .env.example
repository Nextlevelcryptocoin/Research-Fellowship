# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Web SDK configuration used by the browser applicant sign-in.
# These are Firebase project identifiers, not server credentials.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# Stripe and database credentials are server-side only. Do not prefix these
# variables with VITE_ or expose them to the browser.
DATABASE_URL=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
APP_BASE_URL="http://localhost:3000"

# Firebase Admin credentials used to verify applicant ID tokens server-side.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# MASTERIYO LMS INTEGRATION (Server-Side Only)
MASTERIYO_BASE_URL="https://student.unspuniversity.com/wp-json/masteriyo/v1"
MASTERIYO_API_KEY="MY_MASTERIYO_API_KEY"
MASTERIYO_API_SECRET="MY_MASTERIYO_API_SECRET"
