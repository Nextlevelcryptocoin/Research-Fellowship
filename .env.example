# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYMENT PROVIDER CONFIGURATION (Server-Side Only, Never Expose in Frontend)
PAYMENT_PROVIDER="sandbox"
PAYMENT_PROVIDER_KEY="MY_PAYMENT_PROVIDER_KEY"
PAYMENT_PROVIDER_SECRET="MY_PAYMENT_PROVIDER_SECRET"
PAYMENT_WEBHOOK_SECRET="MY_PAYMENT_WEBHOOK_SECRET"

# MASTERIYO LMS INTEGRATION (Server-Side Only)
MASTERIYO_BASE_URL="https://student.unspuniversity.com/wp-json/masteriyo/v1"
MASTERIYO_API_KEY="MY_MASTERIYO_API_KEY"
MASTERIYO_API_SECRET="MY_MASTERIYO_API_SECRET"

